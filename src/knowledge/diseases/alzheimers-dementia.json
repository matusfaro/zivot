{
  "metadata": {
    "id": "alzheimers_dementia_10year",
    "name": "Alzheimer's / Dementia (10-year)",
    "category": "other",
    "timeframe": 10,
    "version": "1.1.0",
    "lastUpdated": "2026-01-03",
    "sources": [
      {
        "citation": "Framingham Study Dementia Incidence",
        "doi": "10.1212/WNL.0000000000001432",
        "evidenceLevel": "cohort"
      }
    ],
    "description": "10-year dementia risk based on CAIDE and ANU-ADRI models (NOTE: Models have limited predictive accuracy)",
    "outcome": "incidence",
    "caseFatality10yr": {
      "value": 0.7,
      "basis": "Derived: median survival after dementia diagnosis ~5.7 years (men dx at 65; shorter at older ages) -> ~70% 10-year mortality under an exponential survival assumption",
      "citation": "Brück CC, Mooldijk SS, Kuiper LM, et al. Projections of life expectancy after dementia diagnosis: systematic review and meta-analysis (235 studies, 5.5M participants). BMJ 2025;388:e080636",
      "doi": "10.1136/bmj-2024-080636",
      "notes": "All-cause mortality among the diagnosed; includes background mortality at typically advanced ages"
    }
  },
