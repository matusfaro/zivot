    {
      "factorId": "diabetes_dementia",
      "name": "Diabetes",
      "modifiable": true,
      "evidenceLevel": "cohort",
      "requiredFields": [
        {
          "path": "medicalHistory.conditions",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "boolean",
        "trueHazardRatio": 1.48,
        "falseHazardRatio": 1.0
      },
      "citation": "Thomassen JQ, Tolstrup JS, Benn M, Frikke-Schmidt R. Type-2 diabetes and risk of dementia: observational and Mendelian randomisation studies in 1 million individuals. Epidemiol Psychiatr Sci. 2020;29:e118",
      "doi": "10.1017/S2045796020000347",
      "notes": "All-cause dementia HR 1.48 (95% CI 1.44-1.53) in 784,434 Danes 65+; AD-specific 1.13, vascular dementia 1.98."
    },
    {
      "factorId": "smoking_dementia",
      "name": "Smoking Status",
      "modifiable": true,
      "evidenceLevel": "meta_analysis",
      "requiredFields": [
        {
          "path": "lifestyle.smoking.status.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "categorical",
        "categories": [
          {
            "value": "never",
            "hazardRatio": 1.0
          },
          {
            "value": "former",
            "hazardRatio": 1.01,
            "confidence": [
              0.96,
              1.06
            ]
          },
          {
            "value": "current",
            "hazardRatio": 1.3,
            "confidence": [
              1.18,
              1.45
            ]
          }
        ]
      },
      "citation": "Zhong G, Wang Y, Zhang Y, Guo JJ, Zhao Y. Smoking Is Associated with an Increased Risk of Dementia: A Meta-Analysis of Prospective Cohort Studies. PLoS ONE. 2015;10(3):e0118333",
      "doi": "10.1371/journal.pone.0118333",
      "notes": "37 cohorts, 960,280 people. Current vs never: all-cause dementia RR 1.30 (1.18-1.45). Former smokers show no excess risk (1.01, 0.96-1.06)."
    },
    {
      "factorId": "family_history_dementia",
      "name": "Family History of Dementia",
      "modifiable": false,
