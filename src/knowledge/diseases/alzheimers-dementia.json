            "hazardRatio": 1.73,
            "confidence": [
              1.59,
              1.87
            ]
          },
          {
            "value": [
              "two_or_more",
              "multiple_first_degree",
              "early_onset_family"
            ],
            "hazardRatio": 3.98,
            "confidence": [
              3.26,
              4.82
            ]
          }
        ]
      },
      "citation": "Cannon-Albright LA, et al. Relative risk for Alzheimer disease based on complete family history. Neurology. 2019;92(15)",
      "doi": "10.1212/WNL.0000000000007231",
      "notes": "Utah Population Database complete family histories: >=1 affected first-degree relative RR 1.73 (1.59-1.87); >=2 FDRs RR 3.98 (3.26-4.82)."
    },
    {
      "factorId": "social_engagement",
