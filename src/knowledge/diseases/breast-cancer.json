    "caseFatality10yr": {
      "value": 0.16,
      "basis": "SEER 5-yr relative survival 91.9% (CFR 0.081); 10-yr relative survival ~84% per ACS-derived figures -> CFR 0.16 used for the 10-year horizon",
      "citation": "SEER Cancer Stat Facts, National Cancer Institute",
      "url": "https://seer.cancer.gov/statfacts/html/breast.html",
      "notes": "10-year figure verified only in secondary sources quoting ACS"
    }
