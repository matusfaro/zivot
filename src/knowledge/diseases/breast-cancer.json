            "value": "two_or_more",
            "hazardRatio": 2.9
          }
        ]
      }
    },
    {
      "factorId": "breast_biopsies",
      "name": "Number of Breast Biopsies",
      "modifiable": false,
      "evidenceLevel": "cohort",
      "requiredFields": [
        {
          "path": "medicalHistory.reproductiveHistory.breastBiopsies.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "categorical",
        "categories": [
          {
            "value": [
              "0",
              "none"
            ],
            "hazardRatio": 1.0
          },
          {
            "value": [
              "1"
            ],
            "hazardRatio": 1.4
          },
          {
            "value": [
              "2",
              "2+",
              "multiple"
            ],
            "hazardRatio": 1.9
          }
        ]
      },
      "citation": "Gail MH, Brinton LA, Byar DP, et al. Projecting individualized probabilities of developing breast cancer for white females who are being examined annually. J Natl Cancer Inst. 1989;81:1879-1886",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3496137/",
      "notes": "Gail model (BCRAT) biopsy relative risks; age-averaged here (age-stratified: <50y ~1.70, >=50y 1.27 per biopsy)."
    },
    {
      "factorId": "atypical_hyperplasia",
      "name": "Atypical Hyperplasia on Biopsy",
      "modifiable": false,
      "evidenceLevel": "cohort",
      "requiredFields": [
        {
          "path": "medicalHistory.reproductiveHistory.atypicalHyperplasia.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "boolean",
        "trueHazardRatio": 1.8,
        "falseHazardRatio": 1.0
      },
      "citation": "Hartmann LC, et al. Benign Breast Disease and the Risk of Breast Cancer. N Engl J Med. 2005;353:229-237",
      "doi": "10.1056/NEJMoa044383",
      "notes": "Standalone RR for atypical hyperplasia is ~4.24 (3.26-5.41). The 1.8 here is the Gail-model-style ADDITIONAL multiplier applied on top of the biopsy-count factor (both factors multiply in this engine), matching BCRAT's x1.82 structure."
    },
