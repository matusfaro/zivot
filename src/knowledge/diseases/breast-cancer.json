      "citation": "Collaborative Group on Hormonal Factors in Breast Cancer. Menarche, menopause, and breast cancer risk: individual participant meta-analysis of 117 studies. Lancet Oncol. 2012;13(11):1141-1151",
      "doi": "10.1016/S1470-2045(12)70425-4",
      "notes": "RR 1.050 (95% CI 1.044-1.057) per year younger at menarche, reference age 13; values compound the per-year estimate."
    },
    {
      "factorId": "age_first_birth",
      "name": "Age at First Live Birth",
      "modifiable": false,
      "evidenceLevel": "meta_analysis",
      "citation": "Collaborative Group on Hormonal Factors in Breast Cancer (meta-analysis)",
      "doi": "10.1016/S1470-2045(02)00754-0",
      "notes": "First birth >30 vs <20: RR=1.8 (95% CI 1.6-2.0). Nulliparity: RR=1.3; each birth protective (RR=0.9).",
      "requiredFields": [
        {
          "path": "medicalHistory.reproductiveHistory.ageAtFirstBirth.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "categorical",
        "categories": [
          {
            "value": [
              "nulliparous",
              "never"
            ],
            "hazardRatio": 1.3
          },
          {
            "value": [
              "under_20",
              "<20"
            ],
            "hazardRatio": 0.75
          },
          {
