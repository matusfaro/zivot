    {
      "factorId": "dizziness_when_standing",
      "name": "Dizziness When Standing (Orthostatic Hypotension)",
      "modifiable": true,
      "evidenceLevel": "meta_analysis",
      "requiredFields": [
        {
          "path": "medicalHistory.fallHistory.dizzinessWhenStanding.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "boolean",
        "trueHazardRatio": 1.7,
        "falseHazardRatio": 1.0
      },
      "citation": "Mol A, et al. Orthostatic Hypotension and Falls in Older Adults: A Systematic Review and Meta-analysis (50 studies, 49,164 individuals). J Am Med Dir Assoc. 2019;20(5):589-597",
      "url": "https://www.jamda.com/article/S1525-8610(18)30635-2/abstract",
      "notes": "Orthostatic hypotension-falls OR 1.73 (1.50-1.99), robust across designs and OH definitions."
    },
    {
      "factorId": "medication_count",
      "name": "Number of Medications (Polypharmacy)",
      "modifiable": true,
      "evidenceLevel": "meta_analysis",
      "citation": "Polypharmacy and Falls (Systematic Review)",
      "doi": "10.1001/jamainternmed.2013.9066",
      "notes": ">4 meds: OR=1.5-2.0.",
      "requiredFields": [
        {
          "path": "medicalHistory.medications.totalMedicationCount.value",
          "alternatives": []
        }
      ],
