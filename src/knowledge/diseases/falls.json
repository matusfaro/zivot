          },
          {
            "value": 10,
            "hazardRatio": 2.0
          }
        ],
        "validRange": [
          0,
          30
        ]
      }
    },
    {
      "factorId": "blood_pressure_meds",
      "name": "Blood Pressure Medications",
      "modifiable": false,
      "evidenceLevel": "meta_analysis",
      "requiredFields": [
        {
          "path": "medicalHistory.medications.takesBloodPressureMeds.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "boolean",
        "trueHazardRatio": 1.1,
        "falseHazardRatio": 1.0,
        "notes": "Can cause orthostatic hypotension"
      },
      "citation": "Kahlaee HR, Latt MD, Schneider CR. Association Between Chronic or Acute Use of Antihypertensive Class of Medications and Falls in Older Adults: A Systematic Review and Meta-Analysis. Drugs Aging. 2018;35(7):625-635",
      "doi": "10.1007/s40266-018-0561-3",
      "notes": "Chronic antihypertensive use: pooled OR 0.97 (0.93-1.01, ns); risk concentrated in the 24h after initiation/dose change; highest pooled estimate 1.24 (1.01-1.50). Modeled conservatively at 1.1."
    },
