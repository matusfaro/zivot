  "riskFactors": [
    {
      "factorId": "smoking_pancreatic",
      "name": "Smoking Status",
      "modifiable": true,
      "evidenceLevel": "meta_analysis",
      "requiredFields": [
        {
          "path": "lifestyle.smoking.status.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "categorical",
        "categories": [
          {
            "value": "never",
            "hazardRatio": 1.0
          },
          {
            "value": "former",
            "hazardRatio": 1.2,
            "confidence": [
              1.11,
              1.29
            ]
          },
          {
            "value": "current",
            "hazardRatio": 1.74,
            "confidence": [
              1.61,
              1.87
            ]
          }
        ]
      },
      "citation": "Iodice S, Gandini S, Maisonneuve P, Lowenfels AB. Tobacco and the risk of pancreatic cancer: a review and meta-analysis (82 studies). Langenbecks Arch Surg. 2008;393:535-545",
      "doi": "10.1007/s00423-007-0266-2",
      "notes": "Current smokers RR 1.74 (1.61-1.87); former 1.20 (1.11-1.29)."
    },
    {
      "factorId": "diabetes_pancreatic",
      "name": "Diabetes (especially new-onset)",
      "modifiable": true,
      "evidenceLevel": "meta_analysis",
      "requiredFields": [
        {
          "path": "medicalHistory.conditions",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "boolean",
        "trueHazardRatio": 1.94,
        "falseHazardRatio": 1.0
      },
      "citation": "Ben Q, et al. Diabetes mellitus and risk of pancreatic cancer: a meta-analysis of cohort studies (35 cohorts). Eur J Cancer. 2011;47(13):1928-1937",
      "url": "https://pubmed.ncbi.nlm.nih.gov/21458985/",
      "notes": "Summary RR 1.94 (1.66-2.27); attenuates to 1.58 (1.42-1.75) for diabetes duration >=5 years (reverse causation strongest in first year)."
    },
    {
      "factorId": "bmi_pancreatic",
      "name": "Body Mass Index",
      "modifiable": true,
      "evidenceLevel": "meta_analysis",
      "requiredFields": [
