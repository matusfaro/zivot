    "id": "cvd_10year",
    "name": "Cardiovascular Disease (10-year)",
    "category": "cardiovascular",
    "timeframe": 10,
    "version": "1.0.0",
    "lastUpdated": "2025-01-03",
    "sources": [
      {
        "citation": "Framingham Heart Study Risk Score",
        "url": "https://www.framinghamheartstudy.org/fhs-risk-functions/cardiovascular-disease-10-year-risk/",
        "evidenceLevel": "cohort"
      },
      {
        "citation": "ACC/AHA Pooled Cohort Equations (2013)",
        "doi": "10.1161/01.cir.0000437741.48606.98",
        "evidenceLevel": "meta_analysis"
      },
      {
        "citation": "Systematic Coronary Risk Evaluation (SCORE)",
        "url": "https://www.escardio.org/Education/Practice-Tools/CVD-prevention-toolbox/SCORE-Risk-Charts",
        "evidenceLevel": "cohort"
      }
    ],
    "description": "10-year risk of fatal or non-fatal cardiovascular events including myocardial infarction, stroke, heart failure, and cardiovascular death",
    "outcome": "incidence",
    "caseFatality10yr": {
      "value": 0.5,
      "basis": "Derived: 1-year post-MI all-cause mortality 24.2% (Danish nationwide cohort 2004-08) plus ~2x-population long-term excess mortality among 1-year survivors (England 2004-2010) compounded over the remaining 9 years",
      "citation": "Schmidt M et al. BMJ 2012;344:e356 (doi:10.1136/bmj.e356); Smolina K et al. Circ Cardiovasc Qual Outcomes 2012 (doi:10.1161/CIRCOUTCOMES.111.964700)",
      "url": "https://pubmed.ncbi.nlm.nih.gov/22279115/",
      "notes": "Includes background mortality of survivors; documented modeling derivation, not a single published 10-year figure"
    }
  },
