        "evidenceLevel": "cohort"
      }
    ],
    "description": "10-year risk of kidney failure based on KFRE",
    "outcome": "incidence",
    "caseFatality10yr": {
      "value": 0.43,
      "basis": "Derived: 5-year all-cause mortality 24.3% in stage-3 CKD (managed-care cohort), extrapolated to 10 years under a constant-hazard assumption (1-(1-0.243)^2)",
      "citation": "Keith DS, Nichols GA, Gullion CM, Brown JB, Smith DH. Longitudinal follow-up and outcomes among a population with chronic kidney disease in a large managed care organization. Arch Intern Med. 2004;164:659-663",
      "url": "https://pubmed.ncbi.nlm.nih.gov/15037495/",
      "notes": "Includes background mortality; stage 4 is substantially higher (45.7% at 5 years)"
    }
  },
