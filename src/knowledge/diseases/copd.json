  "riskFactors": [
    {
      "factorId": "copd_diagnosis",
      "name": "COPD Diagnosis",
      "modifiable": false,
      "evidenceLevel": "meta_analysis",
      "requiredFields": [
        {
          "path": "medicalHistory.conditions",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "boolean",
        "trueHazardRatio": 1.8,
        "falseHazardRatio": 1.0
      },
      "citation": "All-Cause and Cause-Specific Mortality in COPD: A Systematic Review and Meta-Analysis (27 studies, 286,314 individuals). Int J Chron Obstruct Pulmon Dis. 2025",
      "doi": "10.2147/COPD.S563250",
      "notes": "All-cause mortality HR 1.80 (1.40-2.30) for COPD vs non-COPD; GOLD 2 1.75 (1.45-2.12), GOLD 3 1.85 (1.28-2.68)."
    },
    {
      "factorId": "smoking_copd",
      "name": "Smoking Status",
      "modifiable": true,
      "citation": "Lung Health Study - Pack-years and COPD Mortality",
      "doi": "10.1164/rccm.200506-859OC",
      "evidenceLevel": "cohort",
      "notes": "HR=1.03 per pack-year; linear relationship with cumulative smoking exposure",
      "requiredFields": [
        {
          "path": "lifestyle.smoking.status.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "categorical",
        "categories": [
          {
            "value": "never",
            "hazardRatio": 1.0
          },
          {
            "value": "former",
            "hazardRatio": 1.3
          },
          {
            "value": "current",
            "hazardRatio": 2.1
          }
        ]
      }
    },
    {
      "factorId": "pack_years_copd",
      "name": "Pack-Years of Smoking",
      "modifiable": false,
      "evidenceLevel": "cohort",
      "requiredFields": [
        {
          "path": "lifestyle.smoking.packYears.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "continuous",
        "strategy": "lookup",
        "points": [
          {
            "value": 0,
            "hazardRatio": 1.0
          },
          {
            "value": 10,
            "hazardRatio": 1.33
          },
          {
            "value": 20,
            "hazardRatio": 1.5
          },
          {
            "value": 40,
            "hazardRatio": 1.81
          },
          {
            "value": 50,
            "hazardRatio": 1.85
          }
        ],
        "validRange": [
          0,
          100
        ]
      },
      "citation": "Low smoking exposure and development and prognosis of COPD over four decades: a population-based cohort study. Eur Respir J. 2024;64:2400314",
      "url": "https://publications.ersnet.org/content/erj/64/3/2400314",
      "notes": "Among COPD patients, all-cause mortality aHR 1.33 (<10 pack-years) rising to 1.81 (>=40 pack-years) vs non-obstructed light exposure."
    },
    {
      "factorId": "bmi_copd",
      "name": "Body Mass Index (Low BMI increases risk)",
      "modifiable": true,
      "evidenceLevel": "meta_analysis",
      "requiredFields": [
        {
          "path": "biometrics.weight.mostRecent.value.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "continuous",
        "strategy": "lookup",
        "points": [
          {
            "value": 16,
            "hazardRatio": 1.6
          },
          {
            "value": 18.5,
            "hazardRatio": 1.31,
            "confidence": [
              1.04,
              1.64
            ]
          },
          {
            "value": 22,
            "hazardRatio": 1.0
          },
          {
            "value": 27,
            "hazardRatio": 0.75
          },
          {
            "value": 32,
            "hazardRatio": 0.75,
            "confidence": [
              0.62,
              0.9
            ]
          },
          {
            "value": 40,
            "hazardRatio": 1.36,
            "confidence": [
              1.0,
              1.86
            ]
          }
        ],
        "validRange": [
          12,
          50
        ]
      },
      "citation": "The impact of body mass index on mortality in COPD: an updated dose-response meta-analysis (120 studies, 1,053,272 patients). Eur Respir Rev. 2024;33:230261",
      "url": "https://publications.ersnet.org/content/errev/33/174/230261",
      "notes": "U-shaped 'obesity paradox': underweight HR 1.31 (1.04-1.64); overweight 0.62 (0.52-0.73) and class-I obesity 0.75 (0.62-0.90) protective; class-III obesity 1.36 (1.00-1.86). Overweight modeled conservatively at 0.75."
    },
    {
      "factorId": "fev1_percent",
      "name": "FEV1 % Predicted (Lung Function)",
      "modifiable": true,
      "evidenceLevel": "cohort",
      "requiredFields": [
        {
          "path": "medicalHistory.respiratoryHistory.fev1Percent.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "continuous",
        "strategy": "lookup",
        "points": [
          {
            "value": 20,
            "hazardRatio": 6.0
          },
          {
            "value": 30,
            "hazardRatio": 3.5
          },
          {
            "value": 40,
            "hazardRatio": 2.5
          },
          {
            "value": 50,
            "hazardRatio": 1.8
          },
          {
            "value": 60,
            "hazardRatio": 1.3
          },
          {
            "value": 70,
            "hazardRatio": 1.1
          },
          {
            "value": 80,
            "hazardRatio": 1.0
          }
        ],
        "validRange": [
          10,
          100
        ]
      },
      "citation": "Almagro P, et al. Finding the Best Thresholds of FEV1 and Dyspnea to Predict 5-Year Survival in COPD: The COCOMICS Study. PLoS ONE. 2014;9(2):e89866",
      "doi": "10.1371/journal.pone.0089866",
      "notes": "Graded mortality across FEV1 strata; FEV1 <35% predicted carries ~6-fold mortality vs >=75%."
    },
    {
      "factorId": "dyspnea_severity",
      "name": "Dyspnea (Shortness of Breath) Severity",
      "modifiable": true,
      "evidenceLevel": "cohort",
      "requiredFields": [
        {
          "path": "medicalHistory.respiratoryHistory.dyspneaSeverity.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "categorical",
        "categories": [
          {
            "value": [
              "none",
              "0"
            ],
            "hazardRatio": 1.0
          },
          {
            "value": [
              "mild",
              "1"
            ],
            "hazardRatio": 1.4
          },
          {
            "value": [
              "moderate",
              "2"
            ],
            "hazardRatio": 2.0
          },
          {
            "value": [
              "severe",
              "3"
            ],
            "hazardRatio": 3.2
          },
          {
            "value": [
              "very_severe",
              "4"
            ],
            "hazardRatio": 4.8
          }
        ]
      },
      "citation": "Nishimura K, Izumi T, Tsukino M, Oga T. Dyspnea Is a Better Predictor of 5-Year Survival Than Airway Obstruction in Patients With COPD. Chest. 2002;121(5):1434-1440",
      "url": "https://pubmed.ncbi.nlm.nih.gov/12006425/",
      "notes": "Dyspnea grade strongly predicts 5-year survival (p<0.001), outperforming FEV1 staging. Grade-specific HRs here are interpolations pending full-text verification."
    },
    {
      "factorId": "copd_exacerbations",
      "name": "COPD Exacerbations in Past Year",
      "modifiable": true,
      "evidenceLevel": "cohort",
      "requiredFields": [
        {
          "path": "medicalHistory.respiratoryHistory.exacerbationsPerYear.value",
          "alternatives": []
        }
      ],
      "mapping": {
        "type": "categorical",
        "categories": [
          {
            "value": [
              "0",
              "none"
            ],
            "hazardRatio": 1.0
          },
          {
            "value": [
              "1"
            ],
            "hazardRatio": 1.4,
            "confidence": [
              1.21,
              1.62
            ]
          },
          {
            "value": [
              "2"
            ],
            "hazardRatio": 1.96
          },
          {
            "value": [
              "3",
              "3+",
              "multiple"
            ],
            "hazardRatio": 2.74
          }
        ]
      },
      "citation": "Soler-Cataluna JJ, et al. Severe acute exacerbations and mortality in patients with chronic obstructive pulmonary disease. Thorax. 2005;60(11):925-931",
      "url": "https://pubmed.ncbi.nlm.nih.gov/16055622/",
      "notes": "Per-exacerbation mortality HR 1.40 (1.21-1.62), compounded per event; >=3 SEVERE (hospitalized) exacerbations carry HR 4.13 (1.80-9.41) — values here assume unspecified severity."
    }
  ]
